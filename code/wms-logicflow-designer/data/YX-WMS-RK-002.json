      "step": 3,
      "kind": "process"
    },
    {
      "id": "F08",
      "text": "良品分配立库/敏捷仓库位（来源：WMS库存与库位规则）",
      "laneId": "lane-1",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "F09",
      "text": "库位不足→告警",
      "laneId": "lane-4",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "F10",
      "text": "下发入库任务（来源：WMS）",
      "laneId": "lane-1",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "F11",
      "text": "接收任务并调度设备（来源：WCS/RMS）",
      "laneId": "lane-2",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "F12",
      "text": "堆垛机/SCR执行（来源：设备）",
      "laneId": "lane-3",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "F13",
      "text": "设备故障→告警并转人工",
      "laneId": "lane-4",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "F14",
      "text": "接收设备回执，更新库存（来源：设备回执）",
      "laneId": "lane-1",
      "step": 6,
      "kind": "process"
    },
    {
      "id": "F15",
      "text": "物料上架/入箱（来源：设备）",
      "laneId": "lane-3",
      "step": 6,
      "kind": "process"
    },
    {
      "id": "F16",
      "text": "上架失败→重试",
      "laneId": "lane-4",
      "step": 6,
      "kind": "process"
    },
    {
      "id": "F17",
      "text": "回写金蝶：良品下推，不良品另开其他入库（来源：WMS单据）",
      "laneId": "lane-1",
      "step": 7,
      "kind": "process"
    },
    {
      "id": "F18",
      "text": "同步失败→重试并告警",
      "laneId": "lane-4",
      "step": 7,
      "kind": "process"
    },
    {
