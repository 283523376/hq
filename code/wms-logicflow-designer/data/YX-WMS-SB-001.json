    },
    {
      "id": "N13",
      "text": "发起盘点，二次确认（来源：管理员操作）",
      "laneId": "lane-0",
      "step": 7,
      "kind": "process"
    },
    {
      "id": "N14",
      "text": "生成盘点草稿并回填单号（来源：WMS）",
      "laneId": "lane-1",
      "step": 7,
      "kind": "process"
    },
    {
      "id": "N15",
      "text": "无账面→拒绝发起",
