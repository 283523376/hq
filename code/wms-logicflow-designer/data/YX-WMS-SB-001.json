      "kind": "process"
    },
    {
      "id": "N09",
      "text": "按仓库+物料+批次比对（来源：两侧数据）",
      "laneId": "lane-1",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "N10",
      "text": "存在差异→生成差异清单",
      "laneId": "lane-3",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "N11",
      "text": "核对差异清单（来源：管理员操作）",
      "laneId": "lane-0",
      "step": 6,
