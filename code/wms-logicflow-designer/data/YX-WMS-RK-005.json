      "step": 1,
      "kind": "process"
    },
    {
      "id": "G04",
      "text": "选择不良品来源：生产不良 / 受托原材料不良（来源：检验记录）",
      "laneId": "lane-0",
      "step": 2,
      "kind": "process"
    },
    {
      "id": "G05",
      "text": "录入不良数量与原因（来源：检验单）",
      "laneId": "lane-0",
      "step": 3,
      "kind": "process"
    },
    {
      "id": "G06",
      "text": "校验数量合理性（来源：来料/报工数量）",
      "laneId": "lane-1",
      "step": 3,
      "kind": "process"
    },
    {
      "id": "G07",
      "text": "数量超出范围→提示",
      "laneId": "lane-3",
      "step": 3,
      "kind": "process"
    },
    {
      "id": "G08",
      "text": "生产不良写入废品仓默认库位（来源：WMS配置）",
      "laneId": "lane-1",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "G09",
      "text": "废品仓未配置→提示",
      "laneId": "lane-3",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "G10",
      "text": "受托不良选择处置方式，二选一（来源：质检判定）",
      "laneId": "lane-1",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "G11",
      "text": "未选择→提示",
      "laneId": "lane-3",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "G12",
      "text": "入废品仓（受托材料记受托库存）；退货生成采购退货单（来源：ERP采购管理）",
      "laneId": "lane-1",
      "step": 6,
      "kind": "process"
    },
    {
      "id": "G13",
      "text": "记录不良品台账，两类共用（来源：WMS）",
      "laneId": "lane-1",
      "step": 7,
      "kind": "process"
    },
    {
      "id": "G14",
      "text": "回写金蝶：其他入库或退货单（来源：WMS单据）",
      "laneId": "lane-1",
      "step": 8,
      "kind": "process"
    },
    {
      "id": "G15",
      "text": "接收并更新库存（来源：ERP）",
      "laneId": "lane-2",
      "step": 8,
      "kind": "process"
    },
    {
      "id": "G16",
      "text": "同步失败→重试并告警",
