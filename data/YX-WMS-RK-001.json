  "nodes": [
    {
      "id": "E01",
      "text": "登录，进入入库管理（来源：账号权限）",
      "laneId": "lane-0",
      "step": 1,
      "kind": "process"
    },
    {
      "id": "E02",
      "text": "登记到货：供应商/受托方、物料、批次、数量（来源：ERP采购/受托订单）",
      "laneId": "lane-0",
      "step": 2,
      "kind": "process"
    },
    {
      "id": "E03",
      "text": "校验采购/受托订单（来源：金蝶）",
      "laneId": "lane-2",
      "step": 2,
      "kind": "process"
    },
    {
      "id": "E04",
      "text": "订单不存在→提示",
      "laneId": "lane-4",
      "step": 2,
      "kind": "process"
    },
    {
      "id": "E05",
      "text": "选择处理方式：大改小 或 直接入库（来源：来料属性）",
      "laneId": "lane-0",
      "step": 3,
      "kind": "process"
    },
    {
      "id": "E06",
      "text": "大改小加工，原材料变半成品（来源：ERP生产订单）",
      "laneId": "lane-1",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "E07",
      "text": "生成改制单，按生产入库处理（来源：WMS+ERP）",
      "laneId": "lane-2",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "E08",
      "text": "投入不足→提示",
      "laneId": "lane-4",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "E09",
      "text": "分配半成品立库货位（来源：WMS库存与库位规则）",
      "laneId": "lane-2",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "E10",
      "text": "库位不足→告警",
      "laneId": "lane-4",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "E11",
      "text": "下发入库任务（来源：WMS）",
      "laneId": "lane-2",
      "step": 6,
      "kind": "process"
    },
    {
      "id": "E12",
      "text": "堆垛机执行（来源：WCS/RMS）",
      "laneId": "lane-3",
      "step": 6,
      "kind": "process"
    },
    {
      "id": "E13",
      "text": "设备故障→告警并转人工",
      "laneId": "lane-4",
      "step": 6,
      "kind": "process"
    },
    {
      "id": "E14",
      "text": "接收回执，按新物料编码更新库存；受托材料记受托库存（来源：设备回执）",
      "laneId": "lane-2",
      "step": 7,
      "kind": "process"
    },
    {
      "id": "E15",
      "text": "上架失败→重试",
      "laneId": "lane-4",
      "step": 7,
      "kind": "process"
    },
    {
      "id": "E16",
      "text": "回写金蝶：大改小走生产入库，段差棒走采购入库（来源：WMS单据）",
      "laneId": "lane-2",
      "step": 8,
      "kind": "process"
    },
    {
      "id": "E17",
      "text": "同步失败→重试并告警",
      "laneId": "lane-4",
      "step": 8,
      "kind": "process"
    }
  ],
