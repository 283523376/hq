  "nodes": [
    {
      "id": "H01",
      "text": "登录并选择设备与工单（来源：登录账号、设备台账、ERP工单）",
      "laneId": "lane-0",
      "step": 1,
      "kind": "process"
    },
    {
      "id": "H02",
      "text": "调出员工与工单信息（来源：ERP同步工单）",
      "laneId": "lane-1",
      "step": 1,
      "kind": "process"
    },
    {
      "id": "H03",
      "text": "工单不存在→提示",
      "laneId": "lane-3",
      "step": 1,
      "kind": "process"
    },
    {
      "id": "H04",
      "text": "核对工单待领物料与数量（来源：工单BOM）",
      "laneId": "lane-0",
      "step": 2,
      "kind": "process"
    },
    {
      "id": "H05",
      "text": "按工单提示待出库物料与数量（来源：WMS）",
      "laneId": "lane-1",
      "step": 2,
      "kind": "process"
    },
    {
      "id": "H06",
      "text": "物料不符→提示",
      "laneId": "lane-3",
      "step": 2,
      "kind": "process"
    },
    {
      "id": "H07",
      "text": "确认领料数量，可部分领料并修改本次数量（来源：领料人输入）",
      "laneId": "lane-0",
      "step": 3,
      "kind": "process"
    },
    {
      "id": "H08",
      "text": "校验数量不超过工单需求（来源：WMS）",
      "laneId": "lane-1",
      "step": 3,
      "kind": "process"
    },
    {
      "id": "H09",
      "text": "数量超出范围→提示",
      "laneId": "lane-3",
      "step": 3,
      "kind": "process"
    },
    {
      "id": "H10",
      "text": "检查立库库存并分配货位（来源：WMS库存）",
      "laneId": "lane-1",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "H11",
      "text": "库存不足→取消出库并通知改单",
      "laneId": "lane-3",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "H12",
      "text": "下发出库任务（来源：WMS）",
      "laneId": "lane-1",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "H13",
      "text": "接收任务并调度设备（来源：WCS/RMS）",
      "laneId": "lane-2",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "H14",
      "text": "设备故障→告警并转人工",
      "laneId": "lane-3",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "H15",
      "text": "接收设备回执（来源：设备）",
      "laneId": "lane-1",
      "step": 6,
      "kind": "process"
    },
    {
      "id": "H16",
      "text": "复核数量，确认出库并扣减库存（来源：WMS）",
      "laneId": "lane-1",
      "step": 7,
      "kind": "process"
    },
    {
      "id": "H17",
      "text": "复核不一致→提示",
      "laneId": "lane-3",
      "step": 7,
      "kind": "process"
    },
    {
      "id": "H18",
      "text": "回写金蝶生产领料单（来源：WMS单据）",
      "laneId": "lane-1",
      "step": 8,
      "kind": "process"
    },
    {
      "id": "H19",
      "text": "同步失败→重试并告警",
      "laneId": "lane-3",
      "step": 8,
      "kind": "process"
    },
    {
      "id": "H20",
      "text": "生成领料记录：物料/数量/领取人/工单（来源：WMS）",
      "laneId": "lane-1",
      "step": 9,
      "kind": "process"
    }
  ],
