      "step": 3,
      "kind": "process"
    },
    {
      "id": "I08",
      "text": "接收任务并调度设备（来源：WCS/RMS）",
      "laneId": "lane-2",
      "step": 3,
      "kind": "process"
    },
    {
      "id": "I09",
      "text": "SCR执行取箱（来源：设备）",
      "laneId": "lane-3",
      "step": 3,
      "kind": "process"
    },
    {
      "id": "I10",
      "text": "设备故障→告警并转人工",
      "laneId": "lane-4",
      "step": 3,
      "kind": "process"
    },
    {
      "id": "I11",
      "text": "分拣单元输送至出货口（来源：设备）",
      "laneId": "lane-3",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "I12",
      "text": "输送异常→告警",
      "laneId": "lane-4",
      "step": 4,
      "kind": "process"
    },
    {
      "id": "I13",
      "text": "复核出库物料（来源：ERP发货通知单）",
      "laneId": "lane-0",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "I14",
      "text": "校验物料与订单一致性（来源：发货通知单）",
      "laneId": "lane-1",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "I15",
      "text": "不一致→提示",
      "laneId": "lane-4",
      "step": 5,
      "kind": "process"
    },
    {
      "id": "I16",
      "text": "确认出库（来源：仓管员操作）",
      "laneId": "lane-0",
      "step": 6,
      "kind": "process"
    },
    {
      "id": "I17",
      "text": "扣减库存，生成出库单（来源：WMS）",
      "laneId": "lane-1",
      "step": 6,
      "kind": "process"
    },
    {
      "id": "I18",
      "text": "回写金蝶销售出库单（来源：WMS单据）",
      "laneId": "lane-1",
      "step": 7,
      "kind": "process"
    },
    {
