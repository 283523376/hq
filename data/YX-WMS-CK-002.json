      "kind": "process"
    },
    {
      "id": "I04",
      "text": "选择发货通知单开单（来源：仓管员操作）",
      "laneId": "lane-0",
      "step": 2,
      "kind": "process"
    },
    {
      "id": "I05",
      "text": "关联发货通知单开单，支持部分数量（来源：WMS）",
      "laneId": "lane-1",
      "step": 2,
      "kind": "process"
    },
    {
      "id": "I06",
      "text": "库存不足→告警",
      "laneId": "lane-4",
      "step": 2,
      "kind": "process"
    },
    {
      "id": "I07",
      "text": "分配料箱库位并下发出库任务（来源：WMS库存）",
